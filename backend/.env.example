# Scam Shield backend configuration
# Copy this file to .env and fill in the values.

# Get a free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Get a free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get a free API key at https://ocr.space/ocrapi (optional — fallback OCR when Gemini is unavailable)
OCRSPACE_API_KEY=your_ocr_space_api_key_here

# Get a free API key at https://tavily.com (optional — enables live web search
# to check if phone numbers in a message have been publicly reported as scam)
TAVILY_API_KEY=your_tavily_api_key_here
